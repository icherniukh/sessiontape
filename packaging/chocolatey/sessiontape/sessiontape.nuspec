<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>sessiontape</id>
    <version>1.2.0</version>
    <title>SessionTape</title>
    <authors>SessionTape</authors>
    <owners>SessionTape</owners>
    <summary>Records Rekordbox audio output automatically.</summary>
    <description>SessionTape captures your Rekordbox audio output in the background, splits recordings around silence, and saves sessions as MP3 or WAV files.</description>
    <projectUrl>https://github.com/icherniukh/sessiontape</projectUrl>
    <packageSourceUrl>https://github.com/icherniukh/sessiontape/tree/main/packaging/chocolatey</packageSourceUrl>
    <licenseUrl>https://github.com/icherniukh/sessiontape/blob/main/LICENSE</licenseUrl>
    <projectSourceUrl>https://github.com/icherniukh/sessiontape</projectSourceUrl>
    <bugTrackerUrl>https://github.com/icherniukh/sessiontape/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/icherniukh/sessiontape/releases/tag/v1.2.0</releaseNotes>
    <tags>Rekordbox dj audio recorder mp3 wav foss</tags>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
