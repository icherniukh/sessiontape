<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>auto-rb-recorder</id>
    <version>1.2.0</version>
    <title>auto-rb-recorder</title>
    <authors>Ivan Cherniukh</authors>
    <owners>Ivan Cherniukh</owners>
    <summary>Automatically record Rekordbox DJ sets in the background.</summary>
    <description>auto-rb-recorder is an open-source desktop utility that runs in the background and records Pioneer Rekordbox audio sessions automatically. It detects when Rekordbox is playing, splits recordings around silence, and saves finished sessions locally.</description>
    <projectUrl>https://github.com/icherniukh/auto-rb-recorder</projectUrl>
    <packageSourceUrl>https://github.com/icherniukh/auto-rb-recorder/tree/main/packaging/chocolatey</packageSourceUrl>
    <licenseUrl>https://github.com/icherniukh/auto-rb-recorder/blob/main/LICENSE</licenseUrl>
    <projectSourceUrl>https://github.com/icherniukh/auto-rb-recorder</projectSourceUrl>
    <bugTrackerUrl>https://github.com/icherniukh/auto-rb-recorder/issues</bugTrackerUrl>
    <releaseNotes>https://github.com/icherniukh/auto-rb-recorder/releases/tag/v1.2.0</releaseNotes>
    <tags>rekordbox dj audio recorder mp3 wav foss</tags>
    <license type="expression">GPL-3.0-or-later</license>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
